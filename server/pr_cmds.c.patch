 		(&pr_global_struct->parm1)[i] = client->spawn_parms[i];
 }
 
+#define MAX_MAPCYCLE_TEXT 4096
+
+static qboolean SV_MapCyclePickNext (char *rotation, char *out)
+{
+	char text[MAX_MAPCYCLE_TEXT];
+	char first[MAX_QPATH];
+	char *source;
+	char *data;
+	qboolean loaded_from_file;
+	qboolean found_current;
+	int len;
+
+	source = (char *)COM_LoadTempFile (rotation);
+	loaded_from_file = source ? true : false;
+	if (!source)
+		source = rotation;
+
+	len = Q_strlen(source);
+	if (len >= (int)sizeof(text))
+	{
+		Con_Printf ("mapcycle: input too long, truncating\n");
+		len = sizeof(text) - 1;
+	}
+
+	Q_memcpy (text, source, len);
+	text[len] = 0;
+
+	data = text;
+	while (*data)
+	{
+		if (*data == ',' || *data == '\n' || *data == '\r' || *data == '\t')
+			*data = ' ';
+		data++;
+	}
+
+	first[0] = 0;
+	found_current = false;
+	data = text;
+	while (1)
+	{
+		int toklen;
+
+		data = COM_Parse (data);
+		if (!data || !com_token[0])
+			break;
 
+		toklen = Q_strlen(com_token);
+		if (toklen >= MAX_QPATH)
+		{
+			Con_Printf ("mapcycle: map name too long, ignoring: %s\n", com_token);
+			continue;
+		}
+
+		if (!first[0])
+			Q_strcpy (first, com_token);
+
+		if (found_current)
+		{
+			Q_strcpy (out, com_token);
+			return true;
+		}
+
+		if (!Q_strcasecmp(com_token, sv.name))
+			found_current = true;
+	}
+
+	if (!first[0])
+	{
+		if (loaded_from_file)
+			Con_Printf ("mapcycle: no maps found in %s\n", rotation);
+		return false;
+	}
+
+	Q_strcpy (out, first);
+	return true;
+}
