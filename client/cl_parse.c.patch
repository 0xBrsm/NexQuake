+
 char *svc_strings[] =
 {
 	"svc_bad",
@@ -172,8 +176,11 @@
 		case 1:
 			Host_Error ("CL_KeepaliveMessage: received a message");
 			break;
 		case 2:
-			if (MSG_ReadByte() != svc_nop)
+			// Use direct indexing instead of MSG_ReadByte(). CL_KeepaliveMessage()
+			// is called while parsing other messages (e.g., serverinfo precache),
