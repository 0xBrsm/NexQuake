 	r_refdef.horizontalFieldOfView = 2.0 * tan (r_refdef.fov_x/360*M_PI);
 	r_refdef.fvrectx = (float)r_refdef.vrect.x;
 	r_refdef.fvrectx_adj = (float)r_refdef.vrect.x - 0.5;
-	r_refdef.vrect_x_adj_shift20 = (r_refdef.vrect.x<<20) + (1<<19) - 1;
+	r_refdef.vrect_x_adj_shift20 = (r_refdef.vrect.x<<18) + (1<<17) - 1;
 	r_refdef.fvrecty = (float)r_refdef.vrect.y;
 	r_refdef.fvrecty_adj = (float)r_refdef.vrect.y - 0.5;
 	r_refdef.vrectright = r_refdef.vrect.x + r_refdef.vrect.width;
-	r_refdef.vrectright_adj_shift20 = (r_refdef.vrectright<<20) + (1<<19) - 1;
+	r_refdef.vrectright_adj_shift20 = (r_refdef.vrectright<<18) + (1<<17) - 1;
 	r_refdef.fvrectright = (float)r_refdef.vrectright;
 	r_refdef.fvrectright_adj = (float)r_refdef.vrectright - 0.5;
 	r_refdef.vrectrightedge = (float)r_refdef.vrectright - 0.99;
@@ -668,7 +668,26 @@
 	cl.light_level = r_viewlighting.ambientlight;
 #endif
 
-	R_AliasDrawModel (&r_viewlighting);
+	// Viewmodel at a fixed, aspect-independent scale: tie its size to the view
+	// height via the user's base fov at 4:3, not the Hor+-adapted/aspect scale,
+	// so the gun stays put on ultrawide and portrait instead of receding.
+	{
+		extern cvar_t scr_fov;
+		float save_xs = aliasxscale, save_ys = aliasyscale;
+		double pa = pixelAspect > 0.0 ? pixelAspect : 1.0;
+		// scr_fov is clamped to 10-170 in SCR_CalcRefdef, but that lives in a
+		// separate, recalc-gated path; clamp locally so base_vfov is always
+		// positive — a zero/negative scale here would divide-by-zero or invert
+		// the gun, which the software rasterizer cannot survive.
+		double fov_deg = scr_fov.value < 10.0 ? 10.0 : (scr_fov.value > 170.0 ? 170.0 : scr_fov.value);
+		double base_vfov = (2.0 * tan (fov_deg / 360.0 * M_PI)) / (4.0 / 3.0);
+		double gun_ys = (double)r_refdef.vrect.height / base_vfov;
+		aliasyscale = (float)(gun_ys * r_aliasuvscale);
+		aliasxscale = (float)((gun_ys / pa) * r_aliasuvscale);
+		R_AliasDrawModel (&r_viewlighting);
+		aliasxscale = save_xs;
+		aliasyscale = save_ys;
+	}
 }
 
 
