+static qboolean Key_BindingContainsMenu(int key)
+{
+	char	*binding;
+	int		i;
+
+	if (key < 0 || key >= 256)
+		return false;
+	binding = keybindings[key];
+	if (!binding || !binding[0])
+		return false;
+	for (i = 0; binding[i]; i++)
+		if (!Q_strncasecmp(binding + i, "menu", 4))
+			return true;
+	return false;
+}
