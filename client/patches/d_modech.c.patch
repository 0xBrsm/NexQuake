--- d_modech.c
+++ d_modech.c
@@ -72,14 +72,29 @@
 	d_zrowbytes = vid.width * 2;
 	d_zwidth = vid.width;
 
-	d_pix_min = r_refdef.vrect.width / 320;
+	// Particle screen size must track the world projection scale, not raw
+	// render width. Under Native's Hor+ FOV widening, xscale (= width/hFOV)
+	// stays ~constant per detail tier while width balloons with aspect, so the
+	// stock width-keyed sizing oversizes particles on wide/Native modes (most
+	// visibly at High, where width crosses a d_pix_shift power-of-2 step).
+	// 2*xscale == vrect.width at the 4:3 base FOV, so Classic at the default
+	// fov is unchanged; wide/portrait/custom-fov views now size correctly.
+	float pix_ref = 2.0f * xscale;
+
+	d_pix_min = (int)(pix_ref / 320.0f);
 	if (d_pix_min < 1)
 		d_pix_min = 1;
 
-	d_pix_max = (int)((float)r_refdef.vrect.width / (320.0 / 4.0) + 0.5);
-	d_pix_shift = 8 - (int)((float)r_refdef.vrect.width / 320.0 + 0.5);
+	d_pix_max = (int)(pix_ref / (320.0f / 4.0f) + 0.5f);
+	d_pix_shift = 8 - (int)(pix_ref / 320.0f + 0.5f);
 	if (d_pix_max < 1)
 		d_pix_max = 1;
+	// A very wide render or a low fov can drive pix_ref large enough to make
+	// this negative; d_part.c uses it as `izi >> d_pix_shift`, and a negative
+	// shift is undefined behavior. (Reachable since the width cap rose to 3840
+	// in #126 — the stock width-keyed formula has the same latent hole.)
+	if (d_pix_shift < 0)
+		d_pix_shift = 0;
 
 	if (pixelAspect > 1.4)
 		d_y_aspect_shift = 1;
