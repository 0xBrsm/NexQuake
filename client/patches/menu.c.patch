+void M_TouchKeys_Draw (void)
+{
+	qpic_t	*p;
+	char	*bl, *br;
+	int	flip;
+
+	p = Draw_CachePic ("gfx/ttl_cstm.lmp");
+	M_DrawPic ((320 - p->width)/2, 4, p);
+
+	flip = IN_TouchFlipEnabled();
+	bl = keybindings[flip ? K_AUX23 : K_AUX22];	/* physical left  */
+	br = keybindings[flip ? K_AUX22 : K_AUX23];	/* physical right */
+	if (bl && *bl == '+') bl++;
+	if (br && *br == '+') br++;
+
+	M_Print (28, 96, "Tap buttons to bind, hold to drag");
+
+	M_Print (16, 112, "       left screen tap");
+	M_Print (220, 112, (bl && *bl) ? bl : "(unbound)");
+	M_Print (16, 120, "      right screen tap");
+	M_Print (220, 120, (br && *br) ? br : "(unbound)");
+	M_Print (16, 128, "           flip layout");
+	M_DrawCheckbox (220, 128, IN_TouchFlipEnabled());
+	M_Print (16, 136, "Reset button positions");
+
+	if (keys_cursor < 0 || keys_cursor > 3)
+		keys_cursor = 0;
+	M_DrawCharacter (200, 112 + keys_cursor*8, 12 + ((int)(realtime*4)&1));
+}
+
+void M_TouchKeys_Key (int k)
+{
+	switch (k)
+	{
+	case K_ESCAPE:
+		M_Menu_Options_f ();
+		break;
+
+	case K_LEFTARROW:
+	case K_UPARROW:
+		S_LocalSound ("misc/menu1.wav");
+		if (--keys_cursor < 0)
+			keys_cursor = 3;
+		break;
+
+	case K_DOWNARROW:
+	case K_RIGHTARROW:
+		S_LocalSound ("misc/menu1.wav");
+		if (++keys_cursor > 3)
+			keys_cursor = 0;
+		break;
+
+	case K_ENTER:
+		S_LocalSound ("misc/menu2.wav");
+		switch (keys_cursor)
+		{
+		case 0: js_touch_rebind_tap (IN_TouchFlipEnabled() ? 2 : 1); break;
+		case 1: js_touch_rebind_tap (IN_TouchFlipEnabled() ? 1 : 2); break;
+		case 2: IN_ToggleTouchFlip (); break;
+		case 3: js_touch_reset_layout (); break;
+		}
+		break;
+	}
+}
