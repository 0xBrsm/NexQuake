+}
+
+void COM_SwitchGame(const char *gamedir)
+{
+	char mod[16];
+	int i;
+
+	if (!gamedir || !gamedir[0])
+		Q_strcpy(mod, "id1");
+	else
+	{
+		Q_strncpy(mod, gamedir, sizeof(mod) - 1);
+		mod[sizeof(mod) - 1] = 0;
+	}
+	if (Q_strcasecmp(mod, com_active_game) == 0)
+		return;
+
+#ifdef __EMSCRIPTEN__
+	EM_ASM({
+		if (typeof Module === 'undefined') return;
+		if (typeof Module.nexquakeSwitchGameData !== 'function') return;
+		try {
+			Module.nexquakeSwitchGameData(UTF8ToString($0));
+		} catch (e) {
+			if (typeof console !== 'undefined' && console.error)
+				console.error('nexquakeSwitchGameData failed:', e);
+		}
+	}, mod);
+#endif
+
+	for (i = 0; i < com_gamecache_count; i++)
+	{
+		if (Q_strcasecmp(mod, com_gamecache[i].mod) == 0)
+		{
+			com_searchpaths = com_gamecache[i].paths;
+			Q_strncpy(com_gamedir, com_gamecache[i].gamedir, MAX_OSPATH - 1);
+			com_gamedir[MAX_OSPATH - 1] = 0;
+			Q_strncpy(com_active_game, mod, sizeof(com_active_game) - 1);
+			com_active_game[sizeof(com_active_game) - 1] = 0;
+			return;
+		}
+	}
+
+	// Reset to baseline, then add the mod directory on top.
+	com_searchpaths = com_gamecache[0].paths;
+	Q_strncpy(com_gamedir, com_gamecache[0].gamedir, MAX_OSPATH - 1);
+	com_gamedir[MAX_OSPATH - 1] = 0;
+
+	if (Q_strcasecmp(mod, "id1") != 0 && com_basedir[0])
+	{
+		int slot;
+		COM_AddGameDirectory(va("%s/%s", com_basedir, mod));
+		if (com_gamecache_count < MAX_GAMECACHE)
+			slot = com_gamecache_count++;
+		else
+		{
+			slot = com_gamecache_next_replace;
+			com_gamecache_next_replace++;
+			if (com_gamecache_next_replace >= MAX_GAMECACHE)
+				com_gamecache_next_replace = 1;
+		}
+		Q_strncpy(com_gamecache[slot].mod, mod, sizeof(com_gamecache[slot].mod) - 1);
+		com_gamecache[slot].mod[sizeof(com_gamecache[slot].mod) - 1] = 0;
+		com_gamecache[slot].paths = com_searchpaths;
+		Q_strncpy(com_gamecache[slot].gamedir, com_gamedir, MAX_OSPATH - 1);
+		com_gamecache[slot].gamedir[MAX_OSPATH - 1] = 0;
+		fs_hunklevel = Hunk_LowMark();
+	}
+
+	Q_strncpy(com_active_game, mod, sizeof(com_active_game) - 1);
+	com_active_game[sizeof(com_active_game) - 1] = 0;
 }
 
