+void COM_SwitchGame(const char *gamedir)
+{
+	char mod[16];
+	qboolean per_mod_config = true;
+
+	if (!gamedir || !gamedir[0])
+	{
+		Q_strncpy(mod, GAMENAME, sizeof(mod) - 1);
+		mod[sizeof(mod) - 1] = 0;
+	}
+	else
+	{
+		Q_strncpy(mod, gamedir, sizeof(mod) - 1);
+		mod[sizeof(mod) - 1] = 0;
+	}
+	// Save config before switching.  In per-mod mode the save targets the
+	// outgoing mod directory (com_gamedir); in unified mode it targets the
+	// base game directory so no mod-specific config.cfg is ever created.
+#ifdef __EMSCRIPTEN__
+	per_mod_config = EM_ASM_INT({ return Module.nqPerModConfig ? 1 : 0; });
+	if (!per_mod_config)
+	{
+		Q_strncpy(com_gamedir, com_base_gamedir, MAX_OSPATH - 1);
+		com_gamedir[MAX_OSPATH - 1] = 0;
+	}
+#endif
+	Host_WriteConfiguration();
 
+#ifdef __EMSCRIPTEN__
+	EM_ASM({
+		if (typeof Module === 'undefined') return;
+		if (typeof Module.nexquakeSwitchGameData !== 'function') return;
+		try {
+			Module.nexquakeSwitchGameData(UTF8ToString($0));
+		} catch (e) {
+			if (typeof console !== 'undefined' && console.error)
+				console.error('nexquakeSwitchGameData failed:', e);
+		}
+	}, mod);
+#endif
+
+	// Reset to baseline, then add the mod directory on top.
+	com_searchpaths = com_base_searchpaths;
+	Q_strncpy(com_gamedir, com_base_gamedir, MAX_OSPATH - 1);
+	com_gamedir[MAX_OSPATH - 1] = 0;
+
+	if (Q_strcasecmp(mod, GAMENAME) != 0 && com_basedir[0])
+	{
+		COM_AddNQGameDirectories (com_basedir, mod);
+	}
+
+	if (per_mod_config)
+		Cbuf_InsertText("exec quake.rc\n");
+}
